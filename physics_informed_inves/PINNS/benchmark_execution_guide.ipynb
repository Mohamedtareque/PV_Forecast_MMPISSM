                "    if col in df.columns:\n",
                "        for h in rolling_hours:\n",
                "            df[f'{col}_mean_{h}h'] = df[col].shift(1).rolling(f'{h}H', min_periods=1).mean()\n",
                "            df[f'{col}_std_{h}h'] = df[col].shift(1).rolling(f'{h}H', min_periods=1).std()\n",
